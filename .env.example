# ---- Sync auth ----
# Generate with: openssl rand -hex 32
# The same value is pasted into the browser's localStorage on first connect.
SYNC_TOKEN=

# ---- Cloudflare R2 (free 10GB, free egress) ----
# Find these in the Cloudflare dashboard → R2 → "Manage R2 API Tokens".
# R2_ACCOUNT_ID is visible in the page URL after creating the token.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=practice-companion

# ---- Cloudflare R2 bucket CORS (must allow PUT) ----
# AllowedOrigins: https://practice-companion-nine.vercel.app, http://localhost:3000
# AllowedMethods: GET, PUT, HEAD
# AllowedHeaders: *
# ExposeHeaders: ETag
#
# This bucket holds both the audio/sheet blobs (repertoire/{id}/...) and the
# metadata map (meta/repertoire.json). Vercel KV is no longer used — creating
# a store now requires accepting Upstash marketplace terms in a browser.

# ---- Legacy (unused; kept for reference) ----
# GEMINI_API_KEY: Reserved for future Gemini AI API calls.
# APP_URL: Reserved for self-referential links.
