# ---- Sync auth ----
# Generate with: openssl rand -hex 32
# The same value is pasted into the browser's localStorage on first connect.
SYNC_TOKEN=

# ---- Cloudflare R2 (free 10GB, free egress) ----
# Find these in the Cloudflare dashboard → R2 → "Manage R2 API Tokens".
# R2_ACCOUNT_ID is visible in the page URL after creating the token.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=practice-companion

# ---- Vercel KV (auto-injected when you link a KV store to the project) ----
KV_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# ---- Legacy (unused; kept for reference) ----
# GEMINI_API_KEY: Reserved for future Gemini AI API calls.
# APP_URL: Reserved for self-referential links.
